<Window x:Class="AndreasDrawingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Andrea's Drawing App" Height="820" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <TextBlock Grid.Row="0" Text="Andrea's Drawing App"
                   FontSize="22" FontWeight="Bold" Foreground="White"
                   Margin="16,10,16,6"/>

        <!-- Camera feed + drawing overlay stack -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Border CornerRadius="10" ClipToBounds="True" BorderBrush="#444" BorderThickness="1">
                <Grid x:Name="CameraHost" Background="Transparent"
                      MouseLeftButtonDown="CameraHost_MouseLeftButtonDown"
                      MouseMove="CameraHost_MouseMove"
                      MouseLeftButtonUp="CameraHost_MouseLeftButtonUp"
                      MouseLeave="CameraHost_MouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48*"/>
                        <ColumnDefinition Width="685*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CameraImage" Stretch="Uniform" Grid.ColumnSpan="2" />
                    <skia:SKElement x:Name="DrawingSurface" PaintSurface="DrawingSurface_OnPaintSurface" Grid.ColumnSpan="2"/>
                </Grid>
            </Border>

            <!-- Floating control panel -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,16,0" Padding="14" CornerRadius="10"
                    Background="#CC202020" BorderBrush="#555" BorderThickness="1">
                <StackPanel Width="210" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0.299"/>
                            <RotateTransform/>
                            <TranslateTransform X="0.894"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Controls" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- Mode switch -->
                    <TextBlock Text="Mode" Foreground="#CCC" FontSize="11" Margin="0,0,0,2"/>
                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,10">
                        <Button x:Name="DrawModeButton" Content="✏ Draw" Click="DrawModeButton_Click" Padding="4" Margin="0,0,3,0"/>
                        <Button x:Name="GameModeButton" Content="🗼 Tower Game" Click="GameModeButton_Click" Padding="4" Margin="3,0,0,0"/>
                    </UniformGrid>

                    <!-- Drawing controls (Draw mode) -->
                    <StackPanel x:Name="DrawControlsPanel">
                        <TextBlock Text="Stroke Color" Foreground="#CCC" FontSize="11" Margin="0,4,0,2"/>
                        <UniformGrid Rows="1" Columns="6" Height="26" Margin="0,0,0,8">
                            <Button Background="Red"     Click="ColorSwatch_Click" Tag="Red"/>
                            <Button Background="Orange"  Click="ColorSwatch_Click" Tag="Orange"/>
                            <Button Background="Gold"    Click="ColorSwatch_Click" Tag="Gold"/>
                            <Button Background="Lime"    Click="ColorSwatch_Click" Tag="Lime"/>
                            <Button Background="DeepSkyBlue" Click="ColorSwatch_Click" Tag="DeepSkyBlue"/>
                            <Button Background="MediumPurple" Click="ColorSwatch_Click" Tag="MediumPurple"/>
                        </UniformGrid>

                        <TextBlock Text="Thickness" Foreground="#CCC" FontSize="11" Margin="0,4,0,2"/>
                        <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="30" Value="6"
                                TickFrequency="2" IsSnapToTickEnabled="True"
                                ValueChanged="ThicknessSlider_OnValueChanged" Margin="0,0,0,8"/>

                        <CheckBox x:Name="EraserCheckBox" Content="Eraser Mode" Foreground="White"
                                  Checked="EraserCheckBox_OnChanged" Unchecked="EraserCheckBox_OnChanged"
                                  Margin="0,0,0,10"/>

                        <Button Content="🧹 Clear Canvas" Click="ClearButton_Click" Margin="0,0,0,6" Padding="6"/>
                        <Button Content="💾 Save as PNG" Click="SavePngButton_Click" Margin="0,0,0,6" Padding="6"/>
                        <Button Content="📄 Save as PDF" Click="SavePdfButton_Click" Margin="0,0,0,10" Padding="6"/>
                    </StackPanel>

                    <!-- Game controls (Tower Game mode) -->
                    <StackPanel x:Name="GameControlsPanel" Visibility="Collapsed">
                        <TextBlock Text="Tower of Hanoi" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#CCC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Move the whole tower to the right-hand peg. Pinch your thumb and index finger over a tower to lift its top disc, move over another peg, then open your fingers to drop it. A big disc can never sit on a small one. You can also play with the mouse."/>

                        <TextBlock Text="Level" Foreground="#CCC" FontSize="11" Margin="0,0,0,2"/>
                        <Button x:Name="Level1Button" Content="Level 1 (3 discs)" Click="Level1Button_Click" Margin="0,0,0,6" Padding="6"/>
                        <Button x:Name="Level2Button" Content="Level 2 (4 discs)" Click="Level2Button_Click" Margin="0,0,0,6" Padding="6"/>
                        <Button Content="🔄 Restart Level" Click="RestartLevelButton_Click" Margin="0,0,0,10" Padding="6"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,10"/>

                    <Button x:Name="StartStopButton" Content="▶ Start Camera" Click="StartStopButton_Click" Padding="6"/>
                </StackPanel>
            </Border>

            <!-- Gesture / status readout -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="16" Padding="10,6" CornerRadius="8" Background="#CC202020">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gesture: " Foreground="#CCC"/>
                    <TextBlock x:Name="GestureStatusText" Text="None" Foreground="White" FontWeight="Bold" Margin="4,0,16,0"/>
                    <TextBlock Text="Clear hold: " Foreground="#CCC"/>
                    <ProgressBar x:Name="ClearProgressBar" Width="100" Height="14" Minimum="0" Maximum="1" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer status bar -->
        <TextBlock x:Name="FooterStatusText" Grid.Row="2" Text="Ready."
                   Foreground="#999" Margin="16,0,16,10"/>
    </Grid>
</Window>
